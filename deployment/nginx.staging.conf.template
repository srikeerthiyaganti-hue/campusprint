# =============================================================================
# XeroxQueue Staging Nginx Reverse-Proxy Template
# Domain: <STAGING_DOMAIN> (e.g., staging.xeroxqueue.college.edu)
# Static Frontend Path: <STAGING_FRONTEND_DIST_DIR> (e.g., /var/www/xeroxqueue/frontend/dist)
# Backend ASGI Upstream: 127.0.0.1:8000
#
# Instructions:
# 1. Copy this file to /etc/nginx/sites-available/xeroxqueue-staging.conf
# 2. Replace placeholders (<STAGING_DOMAIN>, <SSL_CERT_PATH>, <SSL_KEY_PATH>, <FRONTEND_DIST_PATH>)
# 3. Test configuration: nginx -t
# 4. Enable site: ln -s /etc/nginx/sites-available/xeroxqueue-staging.conf /etc/nginx/sites-enabled/
# 5. Reload nginx: systemctl reload nginx
# =============================================================================

# --- Client Real IP Configuration ---
# If Nginx is behind a cloud load balancer or CDN, specify trusted proxy CIDRs here:
# set_real_ip_from 10.0.0.0/8;
# set_real_ip_from 172.16.0.0/12;
# set_real_ip_from 192.168.0.0/16;
# real_ip_header X-Forwarded-For;
# real_ip_recursive on;

# --- Rate-Limiting Zones ---
# 1. Authentication endpoints (login/signup): 5 requests/minute per IP, burst of 5
limit_req_zone $binary_remote_addr zone=staging_xerox_auth_limit:10m rate=5r/m;

# 2. PDF Upload endpoint: 10 uploads/minute per IP, burst of 5
limit_req_zone $binary_remote_addr zone=staging_xerox_upload_limit:10m rate=10r/m;

# 3. General API endpoints: 30 requests/second per IP, burst of 50
limit_req_zone $binary_remote_addr zone=staging_xerox_api_limit:10m rate=30r/s;

# Return HTTP 429 Too Many Requests when limits are exceeded
limit_req_status 429;

# --- Upstream ASGI Server Pool ---
upstream staging_xerox_backend {
    server 127.0.0.1:8000 fail_timeout=5s max_fails=3;
    keepalive 32;
}

# --- HTTP to HTTPS Redirect ---
server {
    listen 80;
    listen [::]:80;
    server_name <STAGING_DOMAIN>;

    # Allow Let's Encrypt ACME challenges over HTTP
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# --- Staging HTTPS Server ---
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name <STAGING_DOMAIN>;

    # --- TLS Certificates & Hardening ---
    ssl_certificate <SSL_CERT_PATH>;         # e.g., /etc/letsencrypt/live/<STAGING_DOMAIN>/fullchain.pem
    ssl_certificate_key <SSL_KEY_PATH>;       # e.g., /etc/letsencrypt/live/<STAGING_DOMAIN>/privkey.pem
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # --- Security Headers ---
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # Optional HSTS (uncomment once HTTPS is thoroughly verified):
    # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # --- Logging ---
    access_log /var/log/nginx/xeroxqueue_staging_access.log combined;
    error_log /var/log/nginx/xeroxqueue_staging_error.log warn;

    # --- Static Frontend Serving (Vite SPA Build) ---
    root <FRONTEND_DIST_PATH>;               # e.g., /var/www/xeroxqueue/frontend/dist
    index index.html;

    # Serve static frontend with SPA history-mode fallback
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Static build asset caching (hashes generated by Vite)
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # --- Health & Readiness Check Endpoints (Bypass Rate Limiting for Monitors) ---
    location ~ ^/(health|api/health|ready|api/ready)$ {
        proxy_pass http://staging_xerox_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # --- Authentication Endpoints (Strict Rate Limit) ---
    location ~ ^/api/(auth/login|auth/signup|admin/login|partner/auth/login|partner/auth/signup)$ {
        limit_req zone=staging_xerox_auth_limit burst=5 nodelay;

        proxy_pass http://staging_xerox_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    # --- PDF Upload Endpoint (15 MB Max Body Size + Upload Rate Limit) ---
    location = /api/upload {
        limit_req zone=staging_xerox_upload_limit burst=5 nodelay;

        # 10 MB PDF limit in application + multipart overhead
        client_max_body_size 15M;

        proxy_pass http://staging_xerox_backend/api/upload;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
    }

    # --- General API Endpoints ---
    location /api/ {
        limit_req zone=staging_xerox_api_limit burst=50 nodelay;

        client_max_body_size 2M;

        proxy_pass http://staging_xerox_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
}
