# =============================================================================
# XeroxQueue Backend Environment Configuration Template
# Copy this file to backend/.env and update values for your environment.
# Never commit the actual backend/.env file to version control.
# =============================================================================

# Application Environment ('development', 'staging', 'production')
APP_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=xerox_user
DB_PASSWORD=your_secure_mysql_password
DB_NAME=xeroxqueue_db

# Cryptographic Authentication
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_this_to_a_secure_random_64_character_hex_secret_in_production

# Print Shop Administrator Account
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_secure_admin_password

# CORS Configuration (comma-separated origins)
# In development: defaults to localhost and 127.0.0.1 on ports 5173-5175 if unset
# In production: MANDATORY. Wildcard '*' is strictly rejected.
# Example: ALLOWED_ORIGINS=https://xeroxqueue.college.edu,https://admin.xeroxqueue.college.edu
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173

# PDF Storage Backend ('local' or 's3')
# 'local': Stores PDFs on local filesystem under backend/uploads/ (default for development).
# 's3': S3-compatible object storage (suitable for Cloudflare R2, AWS S3, MinIO).
STORAGE_BACKEND=local

# S3-Compatible Storage Settings (Required ONLY if STORAGE_BACKEND=s3)
# S3_ENDPOINT_URL=https://<cloudflare_account_id>.r2.cloudflarestorage.com
# S3_BUCKET_NAME=xeroxqueue-pdfs
# S3_ACCESS_KEY_ID=your_s3_or_r2_access_key_id
# S3_SECRET_ACCESS_KEY=your_s3_or_r2_secret_access_key
# S3_REGION=auto
